# ── Backend (Railway) ───────────────────────────────────────────
APP_SECRET=               # Secret key for JWT signing (any random string, e.g. openssl rand -hex 32)
APP_URL=                  # Frontend URL (e.g. https://yourapp.vercel.app)

# ── Database (Railway MySQL) ───────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Admin ───────────────────────────────────────────────────────
OWNER_EMAIL=              # Email that gets admin role on signup (e.g. wettentertainmentllc@gmail.com)

# ── PayPal (Subscriptions) ─────────────────────────────────────
PAYPAL_CLIENT_ID=         # PayPal app client ID
PAYPAL_CLIENT_SECRET=     # PayPal app secret
PAYPAL_PLAN_PRO_MONTHLY=  # PayPal billing plan ID for Pro tier ($9.99/mo)
PAYPAL_PLAN_ANALYST_MONTHLY= # PayPal billing plan ID for Analyst tier ($29.99/mo)
PAYPAL_WEBHOOK_ID=        # PayPal webhook ID for signature verification

# ── NFL Data Ingestion ─────────────────────────────────────────
BALLDONTLIE_API_KEY=      # balldontlie API key (primary NFL data source)
ODDS_API_KEY=             # The Odds API key (free tier: 500 req/mo)
CRON_TOKEN=               # Secret token to protect cron sync endpoint
# Note: ESPN API requires no key (free public API, used as fallback)

# ── Frontend (Vercel) ──────────────────────────────────────────
VITE_API_URL=             # Backend API URL (e.g. https://yourapp.up.railway.app)
